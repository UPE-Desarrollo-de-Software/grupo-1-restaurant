# .env.dokploy.example
# ---------------------------------------------------------------------
# Variables de cada ambiente del restaurante en Dokploy. NO se copia a ningún
# archivo: los valores se cargan en la pestaña Environment del servicio Compose
# de cada ambiente (dev y producción), y docker-compose.dokploy.yml los toma de
# ahí. Nunca commitear valores reales.
#
# Las marcadas como OBLIGATORIA cortan el deploy con un mensaje si faltan.

# --- ambiente ---
# dev: development / true / debug · producción: production / false / info
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=info

# --- clave de la app (OBLIGATORIA) ---
# Distinta en cada ambiente. Para generarla: php artisan key:generate --show
# (o: echo "base64:$(openssl rand -base64 32)")
APP_KEY=

# --- dominio (OBLIGATORIA) ---
# El dominio configurado en Dokploy para el servicio `web`, sin https://.
# Se usa como APP_URL de la API y como host de los websockets en el frontend.
APP_DOMAIN=

# --- base de datos (OBLIGATORIAS) ---
# Instancia Postgres compartida de la UPE, host interno. Las tablas las crean
# las migraciones al arrancar.
# dev: restoapp-dev · producción: restoapp
DB_HOST=upeservices-proyectos-h3qv51
DB_PORT=5432
DB_DATABASE=restoapp
DB_USERNAME=resto
DB_PASSWORD=

# --- websockets / Reverb (OBLIGATORIAS) ---
# Distintas en cada ambiente. La key también se embebe en el build del frontend.
# REVERB_APP_ID: un número. KEY y SECRET: letras minúsculas y números al azar
# (por ejemplo: openssl rand -hex 10 y openssl rand -hex 16).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# --- imágenes de los platos (opcionales) ---
# Bucket S3 o compatible. Sin esto la app anda, pero subir una imagen da error.
# AWS_URL: URL pública del bucket. AWS_ENDPOINT y AWS_USE_PATH_STYLE_ENDPOINT=true
# solo si no es Amazon S3 (R2, MinIO, Supabase...).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
