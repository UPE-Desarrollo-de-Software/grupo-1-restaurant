 source="e-p-proceso" target="e-p-aprobado"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-pg2-l" value="webhook aprobado" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#ffffff;fontColor=#334155;" vertex="1" connectable="0" parent="f-pg2"><mxGeometry x="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="f-pg3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0369a1;strokeWidth=1.3;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="e-p-proceso" target="e-p-rechazado"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-pg3-l" value="webhook rechazado" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#ffffff;fontColor=#334155;" vertex="1" connectable="0" parent="f-pg3"><mxGeometry x="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="f-pg4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b91c1c;strokeWidth=1.3;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;dashed=1;dashPattern=5 4;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="e-p-proceso" target="e-p-cancelado"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-pg4-l" value="cancelar" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#ffffff;fontColor=#334155;" vertex="1" connectable="0" parent="f-pg4"><mxGeometry x="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="p5-n-pago" value="&lt;b&gt;Idempotencia&lt;/b&gt;&lt;br&gt;mp_payment_id es UNIQUE. El webhook firmado es la fuente de verdad; en_proceso bloquea un nuevo intento para evitar doble cobro. El monto SIEMPRE lo calcula el backend." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4b3f1b;" vertex="1" parent="1"><mxGeometry x="860" y="810" width="500" height="100" as="geometry"/></mxCell><mxCell id="p5-t-mesa" value="Mesa — ciclo de vida de la visita (SoftDeletes)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="700" height="30" as="geometry"/></mxCell><mxCell id="e-m-creada" value="creada · ocupada" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#4338ca;strokeWidth=1.4;fontSize=12;fontColor=#0f172a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1120" width="180" height="54" as="geometry"/></mxCell><mxCell id="e-m-cerrada" value="cerrada · soft delete" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=3;fontSize=12;fontColor=#0f172a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="1120" width="200" height="54" as="geometry"/></mxCell><mxCell id="f-m1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4338ca;strokeWidth=1.3;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="e-m-creada" target="e-m-cerrada"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-m1-l" value="cerrar visita (pagó)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#ffffff;fontColor=#334155;" vertex="1" connectable="0" parent="f-m1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="p5-n-mesa" value="&lt;b&gt;Una fila = una visita&lt;/b&gt;&lt;br&gt;El mozo crea la mesa cuando el cliente se sienta (nace ocupada) y la cierra al cobrar con POST /mesas/{id}/cerrar, que exige 0 pedidos activos. El borrado es lógico: el PIN muere y los pedidos históricos se conservan." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4b3f1b;" vertex="1" parent="1"><mxGeometry x="720" y="1090" width="520" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
