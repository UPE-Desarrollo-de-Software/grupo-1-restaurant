  <diagram name="Página-1" id="lbGBSNnK9n1MHcZEcDah">
    <mxGraphModel dx="1955" dy="752" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\nconfig:\n  layout: elk\n---\nclassDiagram\n  class Usuario {\n    -id: UUID\n    -email: String\n    -contraseña: Hash\n    -rol: Rol\n    +crear()\n    +modificar()\n    +deshabilitar()\n  }\n\n  class Rol {\n    -id: UUID\n    -nombre: String\n    -permisos: List~Permiso~\n    +asignarPermiso()\n    +revocarPermiso()\n  }\n\n  class Permiso {\n    -id: UUID\n    -nombre: String\n    -módulo: String\n  }\n\n  class Categoría {\n    -id: UUID\n    -nombre: String\n    -tipo: enum\n    +crear()\n    +modificar()\n  }\n\n  class Producto {\n    -id: UUID\n    -nombre: String\n    -precio: Decimal\n    -disponible: Boolean\n    -descripción: String\n    -categoría: Categoría\n    +setPrecio()\n    +setDisponibilidad()\n  }\n\n  class Ingrediente {\n    -id: UUID\n    -nombre: String\n    -cantidad: Float\n    -obligatorio: Boolean\n  }\n\n  class Promoción {\n    -id: UUID\n    -nombre: String\n    -precio: Decimal\n    -vigente: Boolean\n    -productos: List~Producto~\n  }\n\n  class Mesa {\n    -id: UUID\n    -número: Int\n    -capacidad: Int\n    -ubicación: String\n    -estado: enum\n    -qr: String\n    +cambiarEstado()\n    +generarQR()\n  }\n\n  class Sesión {\n    -id: UUID\n    -mesa: Mesa\n    -inicio: DateTime\n    -fin: DateTime\n    -mozo: Usuario\n    +abrir()\n    +cerrar()\n  }\n\n  class Reserva {\n    -id: UUID\n    -mesa: Mesa\n    -cliente: String\n    -fecha: Date\n    -hora: Time\n    -personas: Int\n    -estado: enum\n    +confirmar()\n    +cancelar()\n  }\n\n  class Pedido {\n    -id: UUID\n    -sesión: Sesión\n    -tipo: enum\n    -estado: enum\n    -total: Decimal\n    -fecha: DateTime\n    +confirmar()\n    +cambiarEstado()\n  }\n\n  class DetallePedido {\n    -id: UUID\n    -pedido: Pedido\n    -producto: Producto\n    -cantidad: Int\n    -precio: Decimal\n    -personalización: String\n  }\n\n  class Delivery {\n    -id: UUID\n    -pedido: Pedido\n    -repartidor: Usuario\n    -dirección: String\n    -estado: enum\n    -fecha: DateTime\n    +asignarRepartidor()\n    +actualizarEstado()\n  }\n\n  class Insumo {\n    -id: UUID\n    -nombre: String\n    -categoría: String\n    -stock: Float\n    -mínimo: Float\n    +agregarStock()\n    +descontarStock()\n  }\n\n  class Receta {\n    -id: UUID\n    -producto: Producto\n    -ingredientes: List~Insumo~\n    -cantidades: Map\n    +calcularDisponibilidad()\n  }\n\n  Usuario \&quot;1\&quot; --&gt; \&quot;1\&quot; Rol : tiene\n  Rol \&quot;1\&quot; --&gt; \&quot;*\&quot; Permiso : asigna\n  \n  Categoría \&quot;1\&quot; --&gt; \&quot;*\&quot; Producto : contiene\n  Producto \&quot;*\&quot; --&gt; \&quot;*\&quot; Ingrediente : tiene\n  Producto \&quot;*\&quot; --&gt; \&quot;*\&quot; Promoción : participa\n  \n  Mesa \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Sesión : abre\n  Mesa \&quot;1\&quot; --&gt; \&quot;*\&quot; Reserva : reserva\n  Sesión \&quot;*\&quot; --&gt; \&quot;*\&quot; Pedido : genera\n  \n  Pedido \&quot;1\&quot; --&gt; \&quot;*\&quot; DetallePedido : contiene\n  Pedido \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Delivery : solicita\n  DetallePedido \&quot;*\&quot; --&gt; \&quot;1\&quot; Producto : pide\n  \n  Receta \&quot;1\&quot; --&gt; \&quot;1\&quot; Producto : describe\n  Receta \&quot;*\&quot; --&gt; \&quot;*\&quot; Insumo : usa&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="2">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
