<diagram id="p-arq" name="4. Arquitectura por módulos"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="2623" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p4-intro" value="&lt;b&gt;Mapa de dependencias por módulo&lt;/b&gt;&lt;br&gt;Flujo de una request: Controller → UseCase → Service → Repository (interfaz) → Modelo Eloquent. Los controladores no contienen lógica de negocio; los casos de uso orquestan un único servicio." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4b3f1b;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1900" height="60" as="geometry"/></mxCell><mxCell id="m-0-0" value="&lt;div style=&quot;line-height:1.15;&quot;&gt;Autenticación&lt;/div&gt;&lt;div style=&quot;font-size:10px;font-weight:400;color:#475569;margin-top:1px;&quot;&gt;«controllers»&lt;/div&gt;" style="swimlane;html=1;startSize=48;horizontal=1;fontStyle=1;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=0;spacingLeft=2;spacingRight=2;whiteSpace=nowrap;overflow=hidden;fillColor=#e6d4f5;swimlaneFillColor=#f3e8fc;strokeColor=#7e57a8;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="400" height="78" as="geometry"/></mxCell><mxCell id="m-0-0-b" value="&lt;div style=&quot;padding:4px 8px;font-size:11px;line-height:15px;color:#1e293b;white-space:nowrap;&quot;&gt;&lt;div&gt;AuthController&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;overflow=hidden;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="148" width="400" height="30" as="geometry"/></mxCell><mxCell id="m-0-1" value="&lt;div style=&quot;line-height:1.15;&quot;&gt;Autenticación&lt;/div&gt;&lt;div style=&quot;font-size:10px;font-weight: