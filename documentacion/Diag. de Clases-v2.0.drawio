<diagram id="p-repo" name="3. Repositorios y modelos"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="3271" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3-intro" value="&lt;b&gt;Patrón Repository&lt;/b&gt;&lt;br&gt;Cada módulo define una interfaz (contrato) y una implementación Eloquent. Los servicios dependen SOLO de la interfaz; el binding interfaz → implementación se registra en un ServiceProvider. La implementación es la única capa que toca los modelos Eloquent." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4b3f1b;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="860" height="80" as="geometry"/></mxCell><mxCell id="r-if-UsuarioRepository" value="&lt;div style=&quot;line-height:1.15;&quot;&gt;UsuarioRepository&lt;/div&gt;&lt;div style=&quot;font-size:10px;font-weight:400;color:#2f6b3c;margin-top:1px;&quot;&gt;«interface»&lt;/div&gt;" style="swimlane;html=1;startSize=48;horizontal=1;fontStyle=1;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=0;spacingLeft=2;spacingRight=2;whiteSpace=nowrap;overflow=hidden;fillColor=#d3ecdb;swimlaneFillColor=#eaf6ee;strokeColor=#4e8f5d;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="400" height="195" as="geometry"/></mxCell><mxCell id="r-if-UsuarioRepository-b" value="&lt;div style=&quot;padding:4px 8px;font-size:11px;line-height:16px;color:#1e293b;white-space:nowrap;&quot;&gt;&lt;div&gt;+ buscarPorEmail(email): ?Usuario&lt;/div&gt;&lt;div&gt;+ listar(): Collection&lt;/div&gt;&lt;div&gt;+ porId(id): ?Usuario&lt;/div&gt;&lt;div&gt;+ crear(datos): Usuario&lt;/div&gt;&lt;div&gt;+ guardar(usuario, datos): Usuario&lt;/div&gt;&lt;div&gt;+ otroGerenteActivo(rolId, exceptoId): bool&lt;/div&gt;&lt;div&gt;+ emitirToken(usuario, nombre): string&lt;/div&gt;&lt;div&gt;+ revocarTokens(usuario): void&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;overflow=hidden;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="158" width="400" height="147" as="geometry"/></mxCell><mxCell id="r-impl-UsuarioRepository" value="&lt;div style=&quot;line-height:1.15;&quot;&gt;EloquentUsuarioRepository&lt;/div&gt;&lt;div style=&quot;font-size:10px;font-weight:400;color:#2f6b3c;margin-top:1px;&quot;&gt;«implementation»&lt;/div&gt;" style="swimlane;html=1;startSize=48;horizontal=1;fontStyle=1;fontSize=11;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=0;spacingLeft=2;spacingRight=2;whiteSpace=nowrap;overflow=hidden;fillColor=#dcefe2;swimlaneFillColor=#eef7f0;strokeColor=#4e8f5d;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="168.5" width="340" height="78" as="geometry"/></mxCell><mxCell id="r-impl-UsuarioRepository-b" value="&lt;div style=&quot;padding:4px 8px;font-size:11px;line-height:16px;color:#1e293b;white-space:nowrap;&quot;&gt;&lt;div&gt;- modelos: Usuario, Rol&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;overflow=hidden;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="540" y="216.5" width="340" height="30" as="geometry"/></mxCell><mxCell id="r-real-UsuarioRepository" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none; strokeColor=#4e8f5d;strokeWidth=1.2;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r-impl-UsuarioRepository" target="r-if-UsuarioRepository"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r-if-RolRepository" value="&lt;div style=&quot;line-height:1.15;&quot;&gt;RolRepository&lt