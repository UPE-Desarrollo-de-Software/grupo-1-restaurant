                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n  ROL ||--o{ ROL_PERMISO : tiene\n  PERMISO ||--o{ ROL_PERMISO : asignado\n  ROL ||--o{ USUARIO : pertenece\n  USUARIO ||--o{ MESA : atiende\n  MESA ||--o{ RESERVA : tiene\n  MESA ||--o{ PEDIDO : genera\n  PEDIDO ||--o{ DETALLE_PEDIDO : contiene\n  DETALLE_PEDIDO ||--o{ DETALLE_INGREDIENTE : detalle_id\n  DETALLE_PEDIDO ||--o{ DETALLE_INGREDIENTE : pedido_id\n  PROMOCION ||--o{ DETALLE_PEDIDO : aplica\n  PLATO ||--o{ DETALLE_PEDIDO : incluye\n  PLATO ||--o{ PROMOCION : tiene\n  CATEGORIA ||--o{ PLATO : clasifica\n  PLATO ||--o{ PLATO_INGREDIENTE : compuesto_por\n  INGREDIENTE ||--o{ PLATO_INGREDIENTE : usado_en\n\n  ROL {\n    int ROL_ID PK\n    string NOMBRE\n  }\n  ROL_PERMISO {\n    int ROL_ID PK, FK\n    int PERMISO_ID PK, FK\n  }\n  PERMISO {\n    int PERMISO_ID PK\n    string NOMBRE\n    string MODULO\n  }\n  USUARIO {\n    int USUARIO_ID PK\n    int ROL_ID FK\n    string NOMBRE\n    string EMAIL\n    string CONTRASENA\n  }\n  RESERVA {\n    int RESERVA_ID PK\n    int MESA_ID FK\n    date FECHA\n    time HORA\n    int CANT_PERSONAS\n    string CONTACTO_SOLICITANTE\n    string ESTADO\n  }\n  MESA {\n    int MESA_ID PK\n    int USUARIO_ID FK\n    string CODIGO_MESA\n    int CAPACIDAD\n    string ESTADO\n    string QR\n  }\n  PEDIDO {\n    int PEDIDO_ID PK\n    int MESA_ID FK\n    int PEDIDO_ID_1 FK\n    string ESTADO\n    decimal TOTAL\n    datetime FECHA\n  }\n  DETALLE_PEDIDO {\n    int DETALLE_ID PK\n    int PEDIDO_ID FK\n    int PROMOCION_ID FK\n    int PLATO_ID FK\n    int CANTIDAD\n    decimal PRECIO_LISTA\n    decimal SUBTOTAL\n  }\n  DETALLE_INGREDIENTE {\n    int ID PK\n    int DETALLE_ID FK\n    int PEDIDO_ID FK\n    string TIPO\n  }\n  PROMOCION {\n    int PROMOCION_ID PK\n    int PLATO_ID FK\n    string NOMBRE\n    string TIPO\n    decimal VALOR\n    date FECHA_INICIO\n    date FECHA_FIN\n    boolean ACTIVO\n  }\n  PLATO {\n    int PLATO_ID PK\n    int CATEGORIA_ID FK\n    string NOMBRE\n    string DESCRIPCION\n    decimal PRECIO\n    string IMAGEN\n    boolean DISPONIBLE\n    boolean ACTIVO\n  }\n  CATEGORIA {\n    int CATEGORIA_ID PK\n    string NOMBRE\n    string DESCRIPCION\n  }\n  PLATO_INGREDIENTE {\n    int INGREDIENTE_ID PK, FK\n    int PLATO_ID PK, FK\n  }\n  INGREDIENTE {\n    int INGREDIENTE_ID PK\n    string NOMBRE\n    decimal PRECIO_ADICIONAL\n  }\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="2">
